<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Kitzi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 ErciyeSoft · Based on Maccy (MIT) and DockDoor (GPL-3.0)</string>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>Kitzi.sdef</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Kitzi uses AppleEvents to read the files selected in Finder for conversion and to fetch music info from Music and Spotify.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Kitzi plays each app's sound back at the volume you set in the volume mixer.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kitzi reads the battery level of your Bluetooth keyboards, mice and headphones.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Kitzi uses EventKit to show upcoming events in dock widgets.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Kitzi uses EventKit to show upcoming events in dock widgets.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Convert with Kitzi</string>
			</dict>
			<key>NSMessage</key>
			<string>convertFiles</string>
			<key>NSPortName</key>
			<string>Kitzi</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Kitzi Pin Reorder Type</string>
			<key>UTTypeIdentifier</key>
			<string>org.p0deje.Maccy.pin-reorder</string>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
